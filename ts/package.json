{
  "name": "open-transcribe",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "open-transcribe": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run ./src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --outfile dist/open-transcribe ./src/cli.ts",
    "build:sidecar": "bun build --compile --outfile ../app/src-tauri/binaries/open-transcribe-sidecar-x86_64-pc-windows-msvc.exe ./src/sidecar.ts"
  },
  "dependencies": {
    "werift": "^0.24.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
