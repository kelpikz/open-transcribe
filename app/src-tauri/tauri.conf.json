{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-transcribe",
  "version": "0.1.1",
  "identifier": "com.kelpikz.codex-audio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "open-transcribe",
        "url": "index.html",
        "width": 600,
        "height": 780,
        "minWidth": 480,
        "minHeight": 480,
        "visible": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "open-transcribe recording",
        "url": "overlay.html",
        "width": 180,
        "height": 48,
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/open-transcribe-sidecar"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDNzcwRkE5QzlENjY2MUEKUldRYVp0YkpxUTkzTEwyNzRDSGNlS2Y2RE5LTlJqRkJuaml1WXZHNEhCUVBZUVF3bXE5S3ZQUUIK",
      "endpoints": [
        "https://github.com/kelpikz/open-transcribe/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
